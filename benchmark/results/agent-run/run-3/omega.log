        catch(( sread(X1, B2),
                A2=B2
              ),
              C2,
              (   C2=error(D2, E2)
              ->  A2=['Error', D2, E2]
              ;   A2=['Error', C2]
              )),
        true,
        log('INFO', "loop", ['RESPONSE:', Z1], _),
        true,
        'change-state!'('&error', [], _),
        true,
        messagesClear(_),
        F2=G2,
        'HandleError'(Z1, H2, I2),
        (   I2==true
        ->  G2=H2
        ;   llmResponseCalls(T1, J2),
            llmToolCallMessage(role,
                               "assistant",
                               calls,
                               J2,
                               content,
                               "[TOOL CALL]",
                               K2),
            messagesAppend(K2, _),
            findall(L2,
                    ( M2=N2,
                      reduce([O2, L2], M2),
                      superpose(Z1, N2),
                      P2=Q2,
                      'HandleError'(L2, H2, R2),
                      (   R2==true
                      ->  Q2=H2
                      ;   S2=T2,
                          catch(( U2=V2,
                                  findall(W2,
                                          eval(L2, W2),
                                          V2),
                                  'py-call'(['helper.normalize_string', U2],
                                            X2),
                                  T2=X2
                                ),
                                Y2,
                                (   Y2=error(Z2, A3)
                                ->  T2=['Error', Z2, A3]
                                ;   T2=['Error', Y2]
                                )),
                          'HandleError'(S2, H2, B3),
                          (   B3==true
                          ->  Q2=H2
                          ;   'strings-concat'(["SUCCESS, RETURN: ", S2],
                                               Q2)
                          )
                      ),
                      reduce([L2, P2], C3),
                      log('INFO', "loop", ['COMMAND_RETURN:', C3], D3),
                      reduce([_, D3], _),
                      maxFeedback(E3),
                      last_chars(P2, E3, F3),
                      llmToolCallResponseMessage(role,
                                                 "tool",
                                                 callid,
                                                 O2,
                                                 content,
                                                 F3,
                                                 G3),
                      messagesAppend(G3, _)
                    ),
                    G2)
        ),
        ==(F2, [], H3),
        not(H3, I3),
        or(N, I3, J3),
        (   J3==true
        ->  addToHistory(V, F2, N, _)
        ;   true
        )
    ;   get_time(K3),
        'get-state'('&nextWakeAt', L3),
        >(K3, L3, M3),
        (   M3==true
        ->  maxWakeLoops(N3),
            +(1, N3, O3),
            'change-state!'('&loops', O3, _)
        ;   true
        )
    ),
    sleepInterval(P3),
    sleep(P3, _),
    !,
    gc(_),
    +(1, A, Q3),
    omega(Q3, B).
