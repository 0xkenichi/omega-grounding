[32minitMemory(A) :-
    log('INFO', "memory", "Initializing memory", _),
    'configure_Spec_[maxFeedback]'(maxFeedback, 50000, _),
    'configure_Spec_[maxRecallItems]'(maxRecallItems, 20, _),
    'configure_Spec_[maxEpisodeRecallLines]'(maxEpisodeRecallLines, 20, _),
    'configure_Spec_[maxHistory]'(maxHistory, 30000, _),
    'configure_Spec_[embeddingprovider]'(embeddingprovider, 'Local', _),
    embeddingprovider(B),
