        'change-state!'('&loops', Z, A1)
    ;   A1='_'
    ),
    'get-state'('&loops', B1),
    >(B1, 0, C1),
    (   C1==true
    ->  D1=E1,
        (   N==true
        ->  E1=V
        ;   E1="[NO NEW USER INPUT. CONTINUE AUTONOMOUS WORK. DO NOT REPEAT THE PREVIOUS RESPONSE. ONLY USE send FOR GENUINELY NEW INFORMATION OR WHEN USER INPUT IS NEEDED.]"
        ),
        true,
        get_time(F1),
        wakeupInterval(G1),
        +(F1, G1, H1),
        'change-state!'('&nextWakeAt', H1, _),
        true,
        log('INFO', "loop", D1, _),
        I1=J1,
        llmRequestMessage(role, "system", content, H, J1),
        true,
        llmRequestMessage(role, "user", content, D1, K1),
        messagesAppend(K1, _),
        L1=M1,
        messagesGet(N1),
        maxOutputToken(O1),
        reasoningMode(P1),
        collectTools(Q1),
        llmRequest(I1, N1, O1, P1, Q1, M1),
        true,
        reduce([L1], R1),
