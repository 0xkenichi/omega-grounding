[36m(= (add-skill $function $description $arguments)
   (let $text (strings-concat ($description ": " $function " " (join " " $arguments)))
     (progn
       (log INFO "skills" (strings-concat ("Add skill: " $text)))
       (if (== () (collapse (match &self (dynamic-skill $function $info) FOUND)))
         ()
         (progn
           (log INFO "skill" "Re-add skill, removing previous instance")
           (remove-skill $function)))
       (add-atom &self (dynamic-skill $function ($function $description $arguments))) )))
[33m--> prolog clause -->
[32m'add-skill'(A, B, C, D) :-
    E=F,
    join(" ", C, G),
    reduce([B, ": ", A, " ", G], H),
    'strings-concat'(H, F),
    'strings-concat'(["Add skill: ", E], I),
    log('INFO', "skills", I, _),
    findall('FOUND',
            match('&self', ['dynamic-skill', A, _], 'FOUND', 'FOUND'),
            J),
    ==([], J, K),
    (   K==true
    ->  true
    ;   log('INFO', "skill", "Re-add skill, removing previous instance", _),
        'remove-skill'(A, _)
    ),
    'add-atom'('&self', ['dynamic-skill', A, [A, B, C]], D).
